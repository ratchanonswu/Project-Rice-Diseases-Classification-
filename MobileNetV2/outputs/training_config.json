{
  "model_architecture": "MobileNetV2",
  "pretrained_weights": "imagenet",
  "frozen_backbone": true,
  "input_shape": [
    224,
    224,
    3
  ],
  "num_classes": 6,
  "classes": [
    "Bacterial Leaf Blight",
    "Brown Spot",
    "Healthy Rice Leaf",
    "Leaf Blast",
    "Leaf Scald",
    "Sheath Blight"
  ],
  "random_seed": 42,
  "max_epochs": 25,
  "batch_size": 32,
  "learning_rate": 0.0001,
  "optimizer": "Adam",
  "loss": "sparse_categorical_crossentropy",
  "dense_units": 256,
  "dropout_rate": 0.3,
  "augmentation_settings": {
    "random_flip": "horizontal",
